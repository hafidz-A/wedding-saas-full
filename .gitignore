# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# Next.js
.next/
out/
build/
dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment — NEVER commit real keys.
# Catch-all: anything starting with .env is ignored, whatever the suffix, so a
# .env.production / .env.staging / .env.backup / .env.old can't slip through the
# way a hand-listed set would. Only *.example templates are allowed through, and
# those must carry placeholders — never a real value.
.env*
!.env*.example
# Same rule for env files parked anywhere else in the tree.
**/.env*
!**/.env*.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code — personal/local settings (permission allowlist, machine-specific)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
.superpowers/
.playwright-mcp/
.texture-raw/

# Playwright (E2E) — generated artefacts, never commit
/playwright-report/
/test-results/
/playwright/.cache/
/blob-report/

# Microsoft Office lock files
~$*

# Scratch dir for demo-image curation
.tmp/

# Template capture artefacts (screenshots / frames / walkthrough videos)
/captures/

# Knowledge-graph output — regenerated on demand, and it indexes the whole tree
# (env var NAMES show up in it), so keep it out of the repo.
/graphify-out/
