# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — never commit real keys.

# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App config ───────────────────────────────────────────────────────────
# Canonical base URL (no trailing slash). Drives OG/meta tags, sitemap, robots,
# auth email redirect links, and the Midtrans Snap finish redirect URL.
#   • Local dev:  http://localhost:3000
#   • Production: https://www.fincards.land   ← MUST match the canonical domain
#     served by Vercel (www, not the apex). NEXT_PUBLIC_* is inlined at build
#     time, so REDEPLOY after changing this in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin console (operator) ─────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Each MUST exist as a Supabase Auth
# user with a strong password + TOTP MFA enrolled (free). Absent ⇒ nobody is admin.
ADMIN_EMAILS=

# ─── Email (Resend) ───────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ─── Guests table PII encryption ─────────────────────────────────────────
# AES-256-GCM key for encrypting guest names, phone numbers, and notes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP OUT-OF-BAND. Losing this key permanently bricks every encrypted row.
GUESTS_ENCRYPTION_KEY=

# ─── App-domain PII encryption (Tier-1) ──────────────────────────────────
# AES-256-GCM key for RSVPs, gift confirmations, attendances (Buku Tamu), and
# sensitive invitation.config leaves (bank account number/holder, whatsapp).
# Separate from GUESTS_ENCRYPTION_KEY so the two domains rotate independently.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP OUT-OF-BAND. Losing this key permanently bricks every encrypted row.
APP_ENCRYPTION_KEY=

# ─── Midtrans (payment gateway) ───────────────────────────────────────────
# Midtrans (payments). Server Key from Dashboard → Settings → Access Keys.
# Sandbox keys start with SB-Mid-server-, production with Mid-server-.
MIDTRANS_SERVER_KEY=
# 'true' switches to the production API base URLs. Anything else = sandbox.
MIDTRANS_IS_PRODUCTION=false
# NOTE: NEXT_PUBLIC_SITE_URL (above) MUST be your real https domain in prod —
# the Midtrans Snap finish redirect depends on it.
