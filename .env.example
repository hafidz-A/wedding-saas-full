# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored — never commit real keys.

# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App config ───────────────────────────────────────────────────────────
# Canonical base URL (no trailing slash). Drives OG/meta tags, sitemap, robots,
# auth email redirect links, and Xendit success/failure URLs.
#   • Local dev:  http://localhost:3000
#   • Production: https://www.fincards.land   ← MUST match the canonical domain
#     served by Vercel (www, not the apex). NEXT_PUBLIC_* is inlined at build
#     time, so REDEPLOY after changing this in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Resend) ───────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ─── Guests table PII encryption ─────────────────────────────────────────
# AES-256-GCM key for encrypting guest names, phone numbers, and notes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP OUT-OF-BAND. Losing this key permanently bricks every encrypted row.
GUESTS_ENCRYPTION_KEY=

# ─── App-domain PII encryption (Tier-1) ──────────────────────────────────
# AES-256-GCM key for RSVPs, gift confirmations, attendances (Buku Tamu), and
# sensitive invitation.config leaves (bank account number/holder, whatsapp).
# Separate from GUESTS_ENCRYPTION_KEY so the two domains rotate independently.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP OUT-OF-BAND. Losing this key permanently bricks every encrypted row.
APP_ENCRYPTION_KEY=

# ─── Xendit (payment gateway) ─────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use the LIVE secret key in production
# (starts with xnd_production_...), the test key (xnd_development_...) in dev.
XENDIT_SECRET_KEY=
# Dashboard → Settings → Webhooks → "Verification / Callback Token".
# Must MATCH exactly; the webhook rejects callbacks whose x-callback-token differs.
XENDIT_CALLBACK_TOKEN=
# NOTE: NEXT_PUBLIC_SITE_URL (above) MUST be your real https domain in prod —
# Xendit success/failure redirects and the invoice description depend on it.
